<!doctype html>
<html lang="tr">
  <head>
    {%- comment -%}
      Standalone layout for the unlisted /house-renting/ tool: no theme navbar,
      no analytics, no search index, not in the sitemap, noindex.
    {%- endcomment -%}
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow, noarchive">
    <meta name="referrer" content="strict-origin">
    <title>{{ page.title }} · Kiralık 2+1</title>
    <meta name="theme-color" content="#f4f3ef" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#111110" media="(prefers-color-scheme: dark)">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap">
    <link rel="icon" type="image/png" href="{{ '/assets/house-renting/icons/icon-192.png' | relative_url }}">
    <link rel="apple-touch-icon" href="{{ '/assets/house-renting/icons/apple-touch-icon.png' | relative_url }}">
    <link rel="manifest" href="{{ '/house-renting/manifest.webmanifest' | relative_url }}">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="Kiralık 2+1">
    {%- if page.leaflet %}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    {%- endif %}
    {%- assign v = site.time | date: '%s' %}
    <link rel="stylesheet" href="{{ '/assets/house-renting/house.css' | relative_url }}?v={{ v }}">
    <script>
      window.HOUSE_CFG = {
        db: "{{ '/assets/database' | relative_url }}",
        notes: "{{ '/assets/notes.json' | relative_url }}",
        photos: "{{ '/assets/house-renting/photos.json' | relative_url }}?v={{ v }}",
        rail: "{{ '/assets/house-renting/rail.json' | relative_url }}?v={{ v }}",
        root: "{{ '/house-renting/' | relative_url }}",
      };
      // Offline support / "add to home screen" (scope: /house-renting/ only).
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", function () {
          navigator.serviceWorker.register(HOUSE_CFG.root + "sw.js", { scope: HOUSE_CFG.root }).catch(function () {});
        });
      }
    </script>
    <script src="{{ '/assets/house-renting/common.js' | relative_url }}?v={{ v }}"></script>
  </head>
  <body class="h-page-{{ page.house_page }}">
    <header class="h-top">
      <a class="h-brand" href="{{ '/house-renting/' | relative_url }}">🏠 Kiralık 2+1 · Ankara</a>
      <nav class="h-nav" aria-label="Bölümler">
        <a href="{{ '/house-renting/' | relative_url }}" data-nav="list" {% if page.house_page == 'list' %}aria-current="page"{% endif %}>İlanlar</a>
        <a href="{{ '/house-renting/' | relative_url }}?fav=1" data-nav="fav">★ Favoriler <span class="h-badge" data-fav-count>0</span></a>
        <a href="{{ '/house-renting/compare/' | relative_url }}" {% if page.house_page == 'compare' %}aria-current="page"{% endif %}>Karşılaştır <span class="h-badge" data-compare-count>0</span></a>
        <a href="{{ '/house-renting/triage/' | relative_url }}" {% if page.house_page == 'triage' %}aria-current="page"{% endif %}>⚡ Eleme</a>
        <a href="{{ '/house-renting/notes/' | relative_url }}" {% if page.house_page == 'notes' %}aria-current="page"{% endif %}>Notlarım</a>
      </nav>
    </header>
    <main class="h-main">
      {{ content }}
    </main>
    <script src="{{ '/assets/house-renting/' | append: page.house_page | append: '.js' | relative_url }}?v={{ v }}"></script>
  </body>
</html>
